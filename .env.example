# For local development, SQLite works out of the box — no setup needed.
# Switch to PostgreSQL for production/staging, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/electrical_platform
DATABASE_URL=sqlite:///./electrical_platform.db

SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Optional. When set, the Electrical Advisor uses Claude to understand
# free-text problem descriptions (e.g. "my fan is making a weird noise and
# barely spins" instead of needing exact keywords). Leave blank and the
# Advisor still works fully, using keyword matching instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional. When set, the RAG Knowledge Base (Ask a Question) uses Voyage AI
# for real semantic embeddings, giving noticeably better retrieval for
# loosely-worded questions. Leave blank and it still works fully, using a
# local, dependency-free fallback embedding instead - no paid key required.
VOYAGE_API_KEY=
