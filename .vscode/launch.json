{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: run server (debug)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["app.main:app", "--reload", "--port", "8000"],
            "jinja": true,
            "justMyCode": true,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Run seed_data.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/seed_data.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug current test file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-v"],
            "console": "integratedTerminal"
        }
    ]
}
